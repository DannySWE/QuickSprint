////////////////////////////////
//                            //
//    Project related Calls   //
//                            //
////////////////////////////////
//Create a project
POST {{SprintPlannerDashboard.Server_HostAddress_https}}/api/projects
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "name":"test project with mapper"
}
###

//Get all projects
GET {{SprintPlannerDashboard.Server_HostAddress_https}}/api/projects
Authorization: Bearer {{token}}
Accept: application/json
###

//Get project by publicId
GET {{SprintPlannerDashboard.Server_HostAddress_https}}/api/projects/{{projectPublicId}}
Authorization: Bearer {{token}}
Accept: application/json
###

//Update project
PATCH {{SprintPlannerDashboard.Server_HostAddress_https}}/api/projects/{{projectPublicId}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "name":"updated project via patch",
}

###
//Delete project
DELETE {{SprintPlannerDashboard.Server_HostAddress_https}}/api/projects/{{projectPublicId}}
Authorization: Bearer {{token}}
Accept: application/json
###
