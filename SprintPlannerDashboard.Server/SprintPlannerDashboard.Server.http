//Create Sprint
POST {{SprintPlannerDashboard.Server_HostAddress_https}}/api/projectboards/{{projectBoardPublicId}}/sprints
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "name":"test sprint",
  "goal":"to add authrization",
  "status": 0,
  "startdate": "2026-09-25",
  "enddate": "2026-10-25",
  "capacitystorypoints": 10,
  "committedstorypoints": 0,
  "completedstorypoints": 0
}
###
//Get all sprints
GET {{SprintPlannerDashboard.Server_HostAddress_https}}/api/sprints
Authorization: Bearer {{token}}
Accept: application/json
###
//Get a sprint
GET {{SprintPlannerDashboard.Server_HostAddress_https}}/api/sprints/{{sprintPublicId}}
Authorization: Bearer {{token}}
Accept: application/json
###
//Update Sprint
PATCH {{SprintPlannerDashboard.Server_HostAddress_https}}/api/sprints/{{sprintPublicId}}
Authorization: Bearer {{token}}
Content-Type: application/json
{
  "name":"test sprint update",
  "goal":"to add authrization",
  "status": 0,
  "startdate": "2026-09-25",
  "enddate": "2026-10-25",
  "capacitystorypoints": 10,
  "committedstorypoints": 0,
  "completedstorypoints": 0
}
###
//Delete sprint
DELETE {{SprintPlannerDashboard.Server_HostAddress_https}}/api/sprints/{{sprintPublicId}}
Authorization: Bearer {{token}}
Accept: application/json
###
//Get a sprints backlog
GET {{SprintPlannerDashboard.Server_HostAddress_https}}/api/sprints/{{sprintPublicId}}/backlog
Authorization: Bearer {{token}}
Accept: application/json
###
